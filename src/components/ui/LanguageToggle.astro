---
---

<button 
  type="button" 
  class="lang-toggle-btn" 
  id="language-toggle" 
  aria-label="Switch Language (English / မြန်မာ)"
  title="Switch Language (English / မြန်မာ)"
>
  <svg class="globe-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"></circle>
    <line x1="2" y1="12" x2="22" y2="12"></line>
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
  </svg>
  <span class="lang-current-label">EN</span>
</button>

<style>
  .lang-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 38px;
    padding: 0 0.65rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface-2);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.775rem;
    transition: all var(--transition-fast);
    user-select: none;
  }

  .lang-toggle-btn:hover {
    background: var(--bg-surface-hover);
    border-color: var(--aws-orange-border);
    color: var(--aws-orange);
    transform: translateY(-1px);
  }

  .globe-icon {
    color: var(--aws-orange);
    flex-shrink: 0;
  }

  .lang-current-label {
    letter-spacing: 0.04em;
  }
</style>

<script>
  import { toggleLanguage, applyTranslations } from '../../scripts/i18n';

  function setupLangToggle() {
    const btn = document.getElementById('language-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      toggleLanguage();
    });

    applyTranslations();
  }

  setupLangToggle();
  document.addEventListener('astro:page-load', setupLangToggle);
</script>
