---
---

<button
  type="button"
  class="lang-toggle-btn"
  id="language-toggle"
  aria-label="Switch Language"
  title="Switch to Myanmar (မြန်မာဘာသာ)"
>
  <!-- When on English page: Show Myanmar Flag only to switch to Myanmar -->
  <span class="lang-flag-icon lang-flag-my">🇲🇲</span>

  <!-- When on Myanmar page: Show UK Flag only to switch to English -->
  <span class="lang-flag-icon lang-flag-en" style="display:none;">🇬🇧</span>
</button>

<style>
  .lang-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: var(--radius-md);
    background: var(--bg-surface-2);
    border: 1px solid var(--border-medium);
    cursor: pointer;
    transition: all var(--transition-fast);
    user-select: none;
  }

  .lang-toggle-btn:hover {
    background: var(--bg-surface-hover);
    border-color: var(--aws-orange-border);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(255, 153, 0, 0.15);
  }

  .lang-flag-icon {
    font-size: 1.25rem;
    line-height: 1;
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .lang-toggle-btn:hover .lang-flag-icon {
    transform: scale(1.2);
  }

  .lang-toggle-btn:active .lang-flag-icon {
    transform: scale(0.9);
  }
</style>

<script>
  import { toggleLanguage, applyTranslations } from "../../scripts/i18n";

  if (typeof window !== "undefined") {
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest("#language-toggle");
      if (!btn) return;

      e.preventDefault();
      toggleLanguage();
    });

    applyTranslations();
    document.addEventListener("astro:page-load", () => {
      applyTranslations();
    });
  }
</script>
