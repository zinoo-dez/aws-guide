---
import Badge from '../ui/Badge.astro';

interface ServiceItem {
  name: string;
  category: string;
  role: string;
}

interface Metric {
  label: string;
  value: string;
}

interface Props {
  slug: string;
  title: string;
  summary: string;
  difficulty: 'Beginner' | 'Intermediate' | 'Advanced' | 'Expert';
  estimatedMinutes: number;
  awsServices: ServiceItem[];
  keyMetrics?: Metric[];
  industry?: string;
  tags?: string[];
  featured?: boolean;
}

const {
  slug,
  title,
  summary,
  difficulty,
  estimatedMinutes,
  awsServices = [],
  keyMetrics = [],
  industry,
  tags = [],
  featured = false,
} = Astro.props;
---

<article class={`case-study-card glass-card ${featured ? 'featured-card' : ''}`}>
  <div class="card-top-bar">
    <div class="badges-row">
      <Badge variant="difficulty" type={difficulty} size="sm" />
      {industry && <Badge variant="default" size="sm">{industry}</Badge>}
    </div>
    <div class="time-read">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>{estimatedMinutes} min read</span>
    </div>
  </div>

  <div class="card-content">
    <h3 class="card-title">
      <a href={`/case-studies/${slug}`} class="title-link">{title}</a>
    </h3>
    <p class="card-summary">{summary}</p>
  </div>

  {keyMetrics.length > 0 && (
    <div class="card-metrics-row">
      {keyMetrics.slice(0, 2).map((m) => (
        <div class="mini-metric">
          <span class="mini-metric-label">{m.label}:</span>
          <span class="mini-metric-value">{m.value}</span>
        </div>
      ))}
    </div>
  )}

  <div class="card-footer">
    <div class="services-pills">
      {awsServices.slice(0, 3).map((svc) => (
        <Badge variant="category" type={svc.category} size="sm">
          {svc.name}
        </Badge>
      ))}
      {awsServices.length > 3 && (
        <span class="more-services-count">+{awsServices.length - 3}</span>
      )}
    </div>

    <a href={`/case-studies/${slug}`} class="read-more-link" aria-label={`Read case study: ${title}`}>
      <span>Read</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .case-study-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--bg-surface-1);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .case-study-card:hover {
    transform: translateY(-3px);
    border-color: var(--aws-orange-border);
    box-shadow: var(--shadow-md), 0 0 25px rgba(255, 153, 0, 0.12);
  }

  .featured-card {
    border-color: var(--aws-orange-border);
    background: linear-gradient(180deg, rgba(255, 153, 0, 0.04) 0%, var(--bg-surface-1) 100%);
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .badges-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .time-read {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .card-content {
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .card-title {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
    line-height: 1.35;
  }

  .title-link {
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .title-link:hover {
    color: var(--aws-orange);
  }

  .card-summary {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-metrics-row {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-surface-2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .mini-metric {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.775rem;
  }

  .mini-metric-label {
    color: var(--text-muted);
  }

  .mini-metric-value {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text-primary);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    gap: var(--space-2);
  }

  .services-pills {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .more-services-count {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    padding: 0.1rem 0.3rem;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.825rem;
    color: var(--aws-orange);
    transition: transform var(--transition-fast);
  }

  .read-more-link:hover {
    transform: translateX(3px);
  }
</style>
