---
interface Props {
  title: string;
  badge?: string;
}

const { title, badge = 'Technical Deep Dive' } = Astro.props;
---

<details class="deep-dive-accordion glass-card">
  <summary class="accordion-summary">
    <div class="summary-left">
      <span class="deep-dive-pill">{badge}</span>
      <span class="accordion-title">{title}</span>
    </div>
    <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>
  <div class="accordion-content">
    <slot />
  </div>
</details>

<style>
  .deep-dive-accordion {
    margin: var(--space-4) 0;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    background: var(--bg-surface-1);
    overflow: hidden;
    transition: all var(--transition-fast);
  }

  .deep-dive-accordion[open] {
    border-color: var(--aws-orange-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-surface-2);
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background var(--transition-fast);
  }

  .accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-summary:hover {
    background: var(--bg-surface-hover);
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .deep-dive-pill {
    font-size: 0.675rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-full);
    background: rgba(56, 189, 248, 0.12);
    color: #38BDF8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .accordion-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.925rem;
    color: var(--text-primary);
  }

  .chevron-icon {
    color: var(--text-muted);
    transition: transform var(--transition-normal);
  }

  .deep-dive-accordion[open] .chevron-icon {
    transform: rotate(180deg);
    color: var(--aws-orange);
  }

  .accordion-content {
    padding: var(--space-4) var(--space-5);
    background: var(--bg-surface-1);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
