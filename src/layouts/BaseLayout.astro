---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'AWS Architecture Guild – Real-World Case Studies & System Design',
  description = 'Learn AWS cloud system design through real business problems, interactive architecture diagrams, trade-offs, and production metrics.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://aws-guild.dev');
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AWS Architecture Guild - 29+ Production Case Studies & Real-World System Design" />
    <meta property="og:site_name" content="AWS Architecture Guild" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />
    <meta property="twitter:image:alt" content="AWS Architecture Guild - 29+ Production Case Studies & Real-World System Design" />

    <!-- Theme & Language Initialization (Pre-render script to prevent FOUC) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('aws-guild-theme');
        if (savedTheme) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        }

        const savedLang = localStorage.getItem('aws-guild-lang') || 'en';
        document.documentElement.setAttribute('lang', savedLang);
        document.documentElement.setAttribute('data-lang', savedLang);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import { applyTranslations } from '../scripts/i18n';

      function initScrollReveals() {
        if (typeof window === 'undefined') return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
        );

        document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)').forEach((el) => {
          observer.observe(el);
        });
      }

      // Auto-apply translations & scroll observer
      applyTranslations();
      initScrollReveals();

      document.addEventListener('astro:page-load', () => {
        applyTranslations();
        initScrollReveals();
      });
      async function renderAllMermaidDiagrams() {
        if (typeof window === 'undefined') return;

        // Find all pre or .astro-code blocks that contain Mermaid definitions
        const codeBlocks = Array.from(document.querySelectorAll('pre, .astro-code')).filter((pre) => {
          const text = pre.textContent?.trim() || '';
          return (
            pre.classList.contains('language-mermaid') ||
            pre.getAttribute('data-language') === 'mermaid' ||
            Boolean(pre.querySelector('.language-mermaid')) ||
            text.startsWith('graph ') ||
            text.startsWith('graph\n') ||
            text.startsWith('flowchart ') ||
            text.startsWith('sequenceDiagram') ||
            text.startsWith('classDiagram') ||
            text.startsWith('erDiagram') ||
            text.startsWith('stateDiagram')
          );
        });

        const explicitTargets = Array.from(document.querySelectorAll('.mermaid-target, .mermaid'));

        if (codeBlocks.length === 0 && explicitTargets.length === 0) return;

        if (!(window as any).mermaid) {
          const script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
          script.onload = () => {
            executeMermaid(codeBlocks);
          };
          document.head.appendChild(script);
        } else {
          executeMermaid(codeBlocks);
        }
      }

      function executeMermaid(codeBlocks: Element[]) {
        const mermaid = (window as any).mermaid;
        if (!mermaid) return;

        const isLight = document.documentElement.getAttribute('data-theme') === 'light';

        mermaid.initialize({
          startOnLoad: false,
          theme: isLight ? 'default' : 'dark',
          themeVariables: {
            fontFamily: 'Inter, system-ui, sans-serif',
            primaryColor: isLight ? '#FFFBEB' : '#18223B',
            primaryTextColor: isLight ? '#0F172A' : '#F1F5F9',
            primaryBorderColor: isLight ? '#EA580C' : '#FF9900',
            lineColor: isLight ? '#0284C7' : '#38BDF8',
            secondaryColor: isLight ? '#F8FAFC' : '#101728',
            tertiaryColor: isLight ? '#FFFFFF' : '#0B101C',
            background: 'transparent',
            nodeTextColor: isLight ? '#0F172A' : '#F1F5F9',
            mainBkg: isLight ? '#FFFFFF' : '#18223B',
            nodeBorder: isLight ? '#CBD5E1' : '#38BDF8',
            clusterBkg: isLight ? '#F8FAFC' : '#0B101C',
            clusterBorder: isLight ? '#E2E8F0' : '#1E2A4A',
            edgeLabelBackground: isLight ? '#FFFFFF' : '#101728',
          },
          securityLevel: 'loose',
        });

        // Convert markdown code blocks into diagrams
        codeBlocks.forEach(async (block) => {
          if (block.getAttribute('data-mermaid-processed')) return;
          const raw = block.textContent?.trim() || '';
          if (!raw) return;

          const container = document.createElement('div');
          container.className = 'architecture-diagram-card glass-card';
          container.innerHTML = `
            <div class="diagram-toolbar">
              <div class="diagram-title-group">
                <svg class="diagram-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                  <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                  <line x1="6" y1="6" x2="6.01" y2="6"></line>
                  <line x1="6" y1="18" x2="6.01" y2="18"></line>
                </svg>
                <span class="diagram-title">System Architecture Topology</span>
              </div>
            </div>
            <div class="diagram-viewport">
              <div class="mermaid-target mermaid" data-raw="${encodeURIComponent(raw)}"></div>
            </div>
          `;

          block.parentNode?.replaceChild(container, block);
          container.setAttribute('data-mermaid-processed', 'true');

          const target = container.querySelector('.mermaid-target') as HTMLElement;
          const id = 'mermaid-md-' + Math.random().toString(36).substring(2, 9);
          try {
            const { svg } = await mermaid.render(id, raw);
            target.innerHTML = svg;
          } catch (e) {
            console.error('Mermaid render error:', e);
          }
        });

        // Render any explicit targets
        document.querySelectorAll('.mermaid-target').forEach(async (el) => {
          const rawAttr = el.getAttribute('data-raw');
          const raw = rawAttr ? decodeURIComponent(rawAttr) : el.textContent?.trim() || '';
          if (raw && !el.getAttribute('data-rendered')) {
            const id = 'mermaid-el-' + Math.random().toString(36).substring(2, 9);
            try {
              const { svg } = await mermaid.render(id, raw);
              el.innerHTML = svg;
              el.setAttribute('data-rendered', 'true');
            } catch (err) {
              console.error('Mermaid render error:', err);
            }
          }
        });
      }

      renderAllMermaidDiagrams();
      document.addEventListener('astro:page-load', renderAllMermaidDiagrams);
      window.addEventListener('theme-changed', () => {
        document.querySelectorAll('[data-rendered]').forEach(el => el.removeAttribute('data-rendered'));
        document.querySelectorAll('[data-mermaid-processed]').forEach(el => el.removeAttribute('data-mermaid-processed'));
        renderAllMermaidDiagrams();
      });
    </script>
  </body>
</html>

<style>
  #main-content {
    flex: 1;
    min-height: calc(100vh - 64px - 320px);
  }
</style>
