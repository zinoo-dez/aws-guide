---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'AWS Architecture Guild – Real-World Case Studies & System Design',
  description = 'Learn AWS cloud system design through real business problems, interactive architecture diagrams, trade-offs, and production metrics.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://aws-guild.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AWS Architecture Guild - 29+ Production Case Studies & Real-World System Design" />
    <meta property="og:site_name" content="AWS Architecture Guild" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />
    <meta property="twitter:image:alt" content="AWS Architecture Guild - 29+ Production Case Studies & Real-World System Design" />

    <!-- Theme & Language Initialization (Pre-render script to prevent FOUC & preserve on view transitions) -->
    <script is:inline>
      function applyThemeAndLang(doc = document) {
        try {
          const savedTheme = localStorage.getItem('aws-guild-theme');
          let effectiveTheme = 'dark';
          if (savedTheme) {
            effectiveTheme = savedTheme;
          } else {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            effectiveTheme = prefersDark ? 'dark' : 'light';
          }
          doc.documentElement.setAttribute('data-theme', effectiveTheme);

          const savedLang = localStorage.getItem('aws-guild-lang') || 'en';
          doc.documentElement.setAttribute('lang', savedLang);
          doc.documentElement.setAttribute('data-lang', savedLang);
        } catch (e) {
          doc.documentElement.setAttribute('data-theme', 'dark');
        }
      }

      // Initial execution before first render
      applyThemeAndLang(document);

      // Preserve theme & lang across Astro View Transitions
      document.addEventListener('astro:before-swap', (ev) => {
        applyThemeAndLang(ev.newDocument);
      });
      document.addEventListener('astro:after-swap', () => {
        applyThemeAndLang(document);
      });
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import { applyTranslations } from '../scripts/i18n';

      function initScrollReveals() {
        if (typeof window === 'undefined') return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
        );

        document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)').forEach((el) => {
          observer.observe(el);
        });
      }

      // Auto-apply translations & scroll observer
      applyTranslations();
      initScrollReveals();

      document.addEventListener('astro:page-load', () => {
        applyTranslations();
        initScrollReveals();
      });
    </script>
  </body>
</html>

<style>
  #main-content {
    flex: 1;
    min-height: calc(100vh - 64px - 320px);
  }
</style>
