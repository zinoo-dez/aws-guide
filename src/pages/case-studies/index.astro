---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/case-study/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('caseStudies');
const sortedCaseStudies = [...caseStudies].sort((a, b) => a.data.order - b.data.order);

// Collect unique categories
const allCategories = Array.from(
  new Set(caseStudies.flatMap(cs => cs.data.awsServices.map(s => s.category)))
).sort();
---

<BaseLayout 
  title="All 29+ Case Studies | AWS Architecture Guide"
  description="Filterable catalog of production AWS architecture case studies by difficulty, AWS service, domain, and architecture style."
>
  <div class="catalog-page container">
    <header class="catalog-header">
      <span class="section-kicker">Architectural Repository</span>
      <h1 class="catalog-title">Explore Production Case Studies</h1>
      <p class="catalog-subtitle">
        Real-world system design blueprints evaluated through the AWS Well-Architected Framework.
      </p>
    </header>

    <!-- Filters & Search Toolbar -->
    <div class="filters-toolbar glass-card">
      <div class="toolbar-search-row">
        <div class="input-search-wrapper">
          <svg class="search-input-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="catalog-search" 
            class="catalog-search-input" 
            placeholder="Filter by keyword (e.g. SQS, Karpenter, DynamoDB, Multi-Region)..." 
          />
        </div>
        <span id="results-counter" class="results-counter">{sortedCaseStudies.length} Studies</span>
      </div>

      <!-- Filter Pills -->
      <div class="filter-pills-container">
        <!-- Difficulty Filters -->
        <div class="filter-group">
          <span class="filter-label">Difficulty:</span>
          <div class="pills-row" id="difficulty-filters">
            <button type="button" class="filter-pill active" data-filter-type="difficulty" data-value="all">All</button>
            <button type="button" class="filter-pill" data-filter-type="difficulty" data-value="Beginner">Beginner</button>
            <button type="button" class="filter-pill" data-filter-type="difficulty" data-value="Intermediate">Intermediate</button>
            <button type="button" class="filter-pill" data-filter-type="difficulty" data-value="Advanced">Advanced</button>
            <button type="button" class="filter-pill" data-filter-type="difficulty" data-value="Expert">Expert</button>
          </div>
        </div>

        <!-- Category Filters -->
        <div class="filter-group">
          <span class="filter-label">AWS Category:</span>
          <div class="pills-row" id="category-filters">
            <button type="button" class="filter-pill active" data-filter-type="category" data-value="all">All Categories</button>
            {allCategories.map(cat => (
              <button type="button" class="filter-pill" data-filter-type="category" data-value={cat}>{cat}</button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Case Studies Catalog Grid -->
    <div class="catalog-grid" id="catalog-cards-grid">
      {sortedCaseStudies.map((cs, idx) => {
        const serviceNames = cs.data.awsServices.map(s => s.name).join(' ');
        const serviceCategories = cs.data.awsServices.map(s => s.category).join(' ');
        const tags = cs.data.tags.join(' ');
        const styles = cs.data.architectureStyle.join(' ');
        const staggerClass = `stagger-${(idx % 6) + 1}`;

        return (
          <div 
            class={`catalog-card-wrapper reveal-on-scroll ${staggerClass}`} 
            data-difficulty={cs.data.difficulty}
            data-categories={serviceCategories}
            data-services={serviceNames}
            data-tags={tags}
            data-styles={styles}
            data-title={cs.data.title.toLowerCase()}
            data-summary={cs.data.summary.toLowerCase()}
          >
            <CaseStudyCard 
              slug={cs.id}
              title={cs.data.title}
              summary={cs.data.summary}
              difficulty={cs.data.difficulty}
              estimatedMinutes={cs.data.estimatedMinutes}
              awsServices={cs.data.awsServices}
              keyMetrics={cs.data.keyMetrics}
              industry={cs.data.industry}
              tags={cs.data.tags}
              featured={cs.data.featured}
            />
          </div>
        );
      })}
    </div>

    <div id="no-results-msg" class="no-results-box glass-card" hidden>
      <h3>No matching architecture case studies found</h3>
      <p>Try clearing your search query or selecting "All" difficulty levels.</p>
      <button type="button" id="clear-filters-btn" class="btn btn-primary">Reset Filters</button>
    </div>
  </div>
</BaseLayout>

<style>
  .catalog-page {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  .catalog-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .catalog-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-display);
    margin-bottom: var(--space-2);
  }

  .catalog-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto;
  }

  /* Toolbar */
  .filters-toolbar {
    padding: var(--space-5) var(--space-6);
    background: var(--bg-surface-1);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  .toolbar-search-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .input-search-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .search-input-icon {
    position: absolute;
    left: var(--space-3);
    color: var(--aws-orange);
  }

  .catalog-search-input {
    width: 100%;
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    background: var(--bg-surface-2);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 0.95rem;
    font-family: var(--font-body);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .catalog-search-input:focus {
    border-color: var(--aws-orange);
  }

  .results-counter {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .filter-pills-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    min-width: 110px;
  }

  .pills-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 0.25rem 0.65rem;
    font-size: 0.775rem;
    font-family: var(--font-display);
    font-weight: 600;
    border-radius: var(--radius-full);
    background: var(--bg-surface-2);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    background: var(--bg-surface-hover);
    color: var(--text-primary);
  }

  .filter-pill.active {
    background: var(--aws-orange);
    color: #000;
    border-color: var(--aws-orange);
  }

  /* Catalog Grid */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .catalog-card-wrapper {
    display: flex;
    min-width: 0;
    width: 100%;
  }

  .catalog-card-wrapper[hidden] {
    display: none;
  }

  .no-results-box {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    margin-top: var(--space-8);
  }

  .no-results-box h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .no-results-box p {
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  @media (max-width: 640px) {
    .catalog-page {
      padding-top: var(--space-6);
      padding-bottom: var(--space-10);
    }
    .filters-toolbar {
      padding: var(--space-4);
    }
    .toolbar-search-row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }
    .results-counter {
      text-align: right;
    }
    .catalog-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .filter-label {
      min-width: auto;
      width: 100%;
      margin-bottom: 2px;
    }
  }
</style>

<script>
  function setupCatalogFilter() {
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
    const cards = document.querySelectorAll('.catalog-card-wrapper');
    const counter = document.getElementById('results-counter');
    const noResults = document.getElementById('no-results-msg');
    const clearBtn = document.getElementById('clear-filters-btn');

    let activeDifficulty = 'all';
    let activeCategory = 'all';

    function applyFilters() {
      const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const diff = card.getAttribute('data-difficulty') || '';
        const cats = card.getAttribute('data-categories') || '';
        const title = card.getAttribute('data-title') || '';
        const summary = card.getAttribute('data-summary') || '';
        const services = card.getAttribute('data-services') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesDiff = activeDifficulty === 'all' || diff === activeDifficulty;
        const matchesCat = activeCategory === 'all' || cats.includes(activeCategory);
        const matchesQuery = !q || title.includes(q) || summary.includes(q) || services.toLowerCase().includes(q) || tags.toLowerCase().includes(q);

        if (matchesDiff && matchesCat && matchesQuery) {
          card.removeAttribute('hidden');
          visibleCount++;
        } else {
          card.setAttribute('hidden', '');
        }
      });

      if (counter) {
        counter.textContent = `${visibleCount} of ${cards.length} Studies`;
      }

      if (noResults) {
        if (visibleCount === 0) noResults.removeAttribute('hidden');
        else noResults.setAttribute('hidden', '');
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    // Difficulty buttons
    document.querySelectorAll('[data-filter-type="difficulty"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-filter-type="difficulty"]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeDifficulty = btn.getAttribute('data-value') || 'all';
        applyFilters();
      });
    });

    // Category buttons
    document.querySelectorAll('[data-filter-type="category"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-filter-type="category"]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.getAttribute('data-value') || 'all';
        applyFilters();
      });
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeDifficulty = 'all';
      activeCategory = 'all';
      document.querySelectorAll('.filter-pill').forEach(b => {
        if (b.getAttribute('data-value') === 'all') b.classList.add('active');
        else b.classList.remove('active');
      });
      applyFilters();
    });
  }

  setupCatalogFilter();
  document.addEventListener('astro:page-load', setupCatalogFilter);
</script>
