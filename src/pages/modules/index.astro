---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import { getCollection } from 'astro:content';
import { modulesMyanmar } from '../../i18n/modules-my';

const modules = await getCollection('modules');
const sortedModules = [...modules].sort((a, b) => a.data.moduleNumber - b.data.moduleNumber);
const caseStudies = await getCollection('caseStudies');
---

<BaseLayout 
  title="All Modules | AWS Architecture Guide"
  description="Explore the complete 11-module AWS cloud architecture curriculum from Foundations to Advanced Enterprise Capstones."
>
  <div class="modules-index-page container">
    <header class="page-header">
      <span class="section-kicker" data-i18n="modules.kicker">Curriculum Directory</span>
      <h1 class="page-title">
        <span class="text-en">All 11 Learning Modules</span>
        <span class="text-my" hidden>သင်ခန်းစာ Modules ၁၁ ခုလုံး</span>
      </h1>
      <p class="page-subtitle">
        <span class="text-en">Each module covers an essential domain of the AWS cloud ecosystem through core concepts and hands-on production case studies.</span>
        <span class="text-my" hidden>AWS Cloud စနစ်၏ အဓိကနယ်ပယ်များကို အခြေခံသဘောတရားများမှသည် လက်တွေ့ Case Studies များအထိ အဆင့်ဆင့် လေ့လာနိုင်ပါသည်။</span>
      </p>
    </header>

    <div class="modules-grid-full">
      {sortedModules.map((mod, idx) => {
        const modCases = caseStudies.filter(c => c.data.moduleId === mod.id);
        const myMod = modulesMyanmar[mod.id] || null;
        const staggerClass = `stagger-${(idx % 6) + 1}`;

        return (
          <div class={`module-full-card glass-card reveal-on-scroll ${staggerClass}`}>
            <div class="card-left">
              <div class="module-badge-row">
                <span class="mod-pill">Module {mod.data.moduleNumber}</span>
                <Badge variant="difficulty" type={mod.data.difficulty} size="sm" />
                <span class="mod-time">{mod.data.estimatedHours} <span data-i18n="modules.hours">Hours</span></span>
              </div>

              <h2 class="mod-title">
                <a href={`/modules/${mod.id}`}>
                  <span class="text-en">{mod.data.title}</span>
                  <span class="text-my" hidden>{myMod?.title || mod.data.title}</span>
                </a>
              </h2>
              <p class="mod-tagline">
                <span class="text-en">{mod.data.tagline}</span>
                <span class="text-my" hidden>{myMod?.tagline || mod.data.tagline}</span>
              </p>
              <p class="mod-desc">
                <span class="text-en">{mod.data.description}</span>
                <span class="text-my" hidden>{myMod?.description || mod.data.description}</span>
              </p>

              <div class="mod-services-wrap">
                {mod.data.keyServices.map(svc => (
                  <span class="svc-chip">{svc}</span>
                ))}
              </div>
            </div>

            <div class="card-right">
              <span class="cases-count-label">{modCases.length} <span data-i18n="modules.cases">Included Case Studies</span></span>
              <div class="case-links-list">
                {modCases.map(cs => (
                  <a href={`/case-studies/${cs.id}`} class="mini-case-item">
                    <span class="case-item-title">{cs.data.title}</span>
                    <span class="case-item-time">{cs.data.estimatedMinutes}m</span>
                  </a>
                ))}
              </div>

              <a href={`/modules/${mod.id}`} class="btn btn-primary btn-block">
                <span><span data-i18n="modules.explore">Explore Module</span> {mod.data.moduleNumber}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .modules-index-page {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-display);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto;
  }

  .modules-grid-full {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .module-full-card {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-8);
    padding: var(--space-6) var(--space-8);
    background: var(--bg-surface-1);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
    min-width: 0;
    width: 100%;
    overflow: hidden;
  }

  .module-full-card:hover {
    border-color: var(--aws-orange-border);
  }

  .card-left {
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
  }

  .module-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .mod-pill {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--aws-orange);
    background: var(--aws-orange-bg);
    border: 1px solid var(--aws-orange-border);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .mod-time {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .mod-title {
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    margin-bottom: 0.25rem;
    line-height: 1.3;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .mod-title a {
    color: var(--text-display);
  }

  .mod-title a:hover {
    color: var(--aws-orange);
  }

  .mod-tagline {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    line-height: 1.45;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .mod-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .mod-services-wrap {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .svc-chip {
    font-size: 0.725rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: var(--bg-surface-3);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .card-right {
    display: flex;
    flex-direction: column;
    background: var(--bg-surface-2);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    min-width: 0;
    width: 100%;
  }

  .cases-count-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .case-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    margin-bottom: var(--space-4);
    min-width: 0;
  }

  .mini-case-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.6rem;
    background: var(--bg-surface-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.8rem;
    transition: all var(--transition-fast);
    min-width: 0;
    gap: 0.4rem;
  }

  .mini-case-item:hover {
    background: var(--bg-surface-hover);
    color: var(--aws-orange);
  }

  .case-item-title {
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1;
  }

  .case-item-time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  .btn-block {
    width: 100%;
  }

  @media (max-width: 900px) {
    .module-full-card {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding: var(--space-5);
    }
  }

  @media (max-width: 480px) {
    .modules-index-page {
      padding-top: var(--space-6);
      padding-bottom: var(--space-10);
    }
    .page-header {
      margin-bottom: var(--space-8);
    }
    .module-full-card {
      padding: var(--space-4);
      border-radius: var(--radius-md);
    }
    .card-right {
      padding: var(--space-3) var(--space-4);
    }
  }
</style>
